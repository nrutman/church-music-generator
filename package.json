{
  "name": "church-music-generator",
  "version": "1.0.0",
  "description": "Generate Providence Church-format chord and lyric sheet .docx files",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "pnpm build && vitest run",
    "test:typescript": "pnpm test",
    "generate": "pnpm build && bash src/build.sh",
    "check-deps": "bash src/check-deps.sh",
    "preview": "bash src/preview.sh",
    "clean-previews": "rm -rf generated/preview && echo 'Cleaned up preview files.'",
    "extract-chords": "pnpm build && node dist/extract-chord-positions.js",
    "extract-chords-ocr": "pnpm build && node dist/extract-chords-ocr.js",
    "publish-song": "pnpm build && bash src/publish.sh",
    "binder": "pnpm build && bash src/binder.sh",
    "binder:resolve": "pnpm binder resolve",
    "binder:build": "pnpm binder build",
    "binder:pco-resolve": "pnpm binder pco-resolve",
    "binder:pco-build": "pnpm binder pco-build",
    "binder:doctor": "pnpm binder doctor"
  },
  "dependencies": {
    "docx": "^9.10.0",
    "opentype.js": "^2.0.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "vite": "8.3.4"
    }
  }
}
