{
  "name": "church-music-generator",
  "version": "1.0.0",
  "description": "Generate Providence Church-format chord and lyric sheet .docx files",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "format:python": "python3 -m ruff check src/ && python3 -m ruff format --check src/",
    "format:python:fix": "python3 -m ruff check --fix src/ && python3 -m ruff format src/",
    "test": "pnpm test:typescript && pnpm test:python",
    "test:typescript": "vitest run",
    "generate": "pnpm build && bash src/build.sh",
    "check-deps": "bash src/check-deps.sh",
    "preview": "bash src/preview.sh",
    "clean-previews": "rm -rf generated/preview && echo 'Cleaned up preview files.'",
    "extract-chords": "python3 src/extract-chord-positions.py",
    "test:python": "python3 -m pytest src/__tests__/test_*.py -v"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.2.0"
    }
  }
}
