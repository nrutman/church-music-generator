# Publishing destinations and Planning Center Personal Access Token credentials.
# Copy these entries to .env.local and fill in local values before publishing.
# GOOGLE_DRIVE_LYRIC_DIR="$HOME/Google Drive/My Drive/Music/Lyric Sheets"
# GOOGLE_DRIVE_CHORD_DIR="$HOME/Google Drive/My Drive/Music/Chord Sheets"
# PLANNING_CENTER_CLIENT_ID=""
# PLANNING_CENTER_SECRET=""
# PLANNING_CENTER_USER_AGENT="Providence Church Music Generator (your-email@example.com)"
# PLANNING_CENTER_DEFAULT_SERVICE_TYPE_ID=""

# Binder input/output. Copy these values to .env.local before building binders.
# CHORD_SHEETS_DIR="$HOME/Google Drive/My Drive/Music/Chord Sheets"
# BINDER_OUTPUT_DIR="$HOME/Google Drive/My Drive/Music/Binders"
# FUZZY_MATCH_THRESHOLD="0.75"
# SOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"
